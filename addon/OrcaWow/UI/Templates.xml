<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\Blizzard_SharedXML\UI.xsd">
	<!-- The message box: Enter sends, Shift+Enter adds a line (handled in MainFrame.lua). -->
	<Frame name="OrcaWowComposerTemplate" inherits="ScrollingEditBoxTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="useDefaultEnterHandling" value="false" type="boolean"/>
			<KeyValue key="maxLetters" value="2000" type="number"/>
			<KeyValue key="fontName" value="ChatFontNormal" type="string"/>
		</KeyValues>
	</Frame>

	<!-- The copy box: holds text selected for Ctrl+C (the game gives addons no clipboard). -->
	<Frame name="OrcaWowCopyBoxTemplate" inherits="ScrollingEditBoxTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="maxLetters" value="10000" type="number"/>
			<KeyValue key="fontName" value="ChatFontNormal" type="string"/>
		</KeyValues>
	</Frame>

	<!-- One template per kind of list row: ScrollBox recycles rows per template, so
	     sharing a plain "Frame" between kinds would leave one kind's text on another. -->
	<Frame name="OrcaWowMessageRowTemplate" virtual="true"/>
	<Frame name="OrcaWowNoteRowTemplate" virtual="true"/>
	<Button name="OrcaWowOptionRowTemplate" virtual="true"/>
	<Button name="OrcaWowThreadRowTemplate" virtual="true"/>
	<Button name="OrcaWowGroupHeaderTemplate" virtual="true"/>
	<Frame name="OrcaWowEmptyRowTemplate" virtual="true"/>
	<Button name="OrcaWowDropdownRowTemplate" virtual="true"/>
</Ui>
